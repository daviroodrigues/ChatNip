# ==============================================================================
#  CHATNIP WHATSAPP GATEWAY — .env.example
#  Template de Configuração Simplificado (Sem fallbacks, Nginx como ponto único)
# ==============================================================================

# [01] EXECUÇÃO & COMPOSE
# Perfis: 'prod' (Nginx + Core + Backup) | 'dev' (+ RabbitMQ + Squid Proxy)
COMPOSE_PROFILES=prod
ENVIRONMENT=development
TZ=America/Sao_Paulo

# [02] REVERSE PROXY — NGINX (Único ponto de entrada exposto)
NGINX_PORT=80

# [03] MICROSERVICE — WHATSAPP CORE (Go)
WHATSAPP_GO_PORT=80
WHATSAPP_GO_API_VERSION=v1
# Master Internal Key: Gerar com 'openssl rand -hex 16'
WHATSAPP_GO_INTERNAL_KEY=your_32_char_master_internal_key_here
# Encryption Key para SQLite: Gerar com 'openssl rand -hex 16' (exatamente 32 chars)
WHATSAPP_GO_ENCRYPTION_KEY=your_32_char_encryption_key_here
WHATSAPP_GO_DB_PATH=/data/whatsapp.db

# [04] MENSAGERIA — RABBITMQ
# Conecta ao RabbitMQ externo (guara_erp) exposto na porta 5672 do host
RABBITMQ_URL=amqp://RABBITMQ_USER:RABBITMQ_PASSWORD@host.docker.internal:5672/

# [05] EGRESS PROXY — SQUID MOCK (Somente Dev, isolado na rede interna)
SQUID_PROXY_USER=chatnip
SQUID_PROXY_PASS=chatnip

# [06] OBJECT STORAGE — S3 / R2 / MINIO
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_BUCKET=chatnip-backups

# [07] BACKUP & RETENÇÃO (OpenGPG + GFS)
BACKUP_GPG_PUBLIC_KEY_PATH=/keys/backup-public.asc
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RUN_ON_STARTUP=true
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_RETENTION_YEARLY=3
BACKUP_WEEKLY_DOW=7
BACKUP_MONTHLY_DOM=01
