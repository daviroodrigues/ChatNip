# ==============================================================================
#  CHATNIP WHATSAPP GATEWAY — .env.example
#  Template de Configuração (Sem fallbacks silenciosos, Nginx como ponto único)
# ==============================================================================

# [01] EXECUÇÃO & COMPOSE
# Perfis: 'prod' (Nginx + Core + Backup) | 'dev' (+ Squid Proxy Mock)
COMPOSE_PROFILES=prod
ENVIRONMENT=development
TZ=America/Sao_Paulo

# [02] REVERSE PROXY — NGINX (Único ponto de entrada exposto)
NGINX_PORT=80

# [03] MICROSERVICE — CHATNIP CORE (Go)
CHATNIP_PORT=80
CHATNIP_API_VERSION=v1
# Master Internal Key: Gerar com 'openssl rand -hex 16'
CHATNIP_INTERNAL_KEY=your_32_char_master_internal_key_here
# Encryption Key para SQLite (AES-256-GCM): Gerar com 'openssl rand -hex 16' (exatamente 32 chars)
CHATNIP_ENCRYPTION_KEY=your_32_char_encryption_key_here
CHATNIP_DB_PATH=/data/whatsapp.db

# [04] MENSAGERIA — RABBITMQ
# Conexão com o RabbitMQ externo (compose monta amqp://USER:PASSWORD@HOST/)
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_HOST=host.docker.internal:5672

# [05] INTEGRAÇÃO BACKEND & MÍDIA (Opcional)
BACKEND_API_URL=http://host.docker.internal/api/v1
BACKEND_INTERNAL_API_KEY=your_backend_internal_api_key_here
MEDIA_TEMP_DIR=/tmp

# [06] EGRESS PROXY — SQUID MOCK (Somente Dev, isolado na rede interna)
SQUID_PROXY_USER=chatnip
SQUID_PROXY_PASS=chatnip

# [07] OBJECT STORAGE — S3 / R2 / MINIO
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_BUCKET=chatnip-backups

# [08] BACKUP & RETENÇÃO (OpenGPG + GFS)
BACKUP_GPG_PUBLIC_KEY_PATH=/keys/backup-public.asc
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RUN_ON_STARTUP=true
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_RETENTION_YEARLY=3
BACKUP_WEEKLY_DOW=7
BACKUP_MONTHLY_DOM=01
